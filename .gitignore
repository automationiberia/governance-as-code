# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Ansible / Molecule
.ansible/
*.retry

# Collection build artifacts (ansible-galaxy collection build)
*.tar.gz

# Per-person files written by starter-kit/setup/gac-setup.sh in content
