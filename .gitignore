.claude/settings.json
.claude/settings.local.json
.claude/hooks/gac-hook.json
# …except the guardrail demo repository, whose hook config is relative on purpose
!examples/ex-04-harness-slots/demo-repo/.claude/hooks/gac-hook.json

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
